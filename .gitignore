# Python environments and generated bytecode
.venv/
venv/
env/
ENV/
__pycache__/
*.py[cod]
*$py.class

# Packaging and application builds (keep ShortMaker.spec in Git)
/build/
/dist/
*.egg-info/
.eggs/
*.egg

# Downloaded tools and optional speech models
/.tools/
/tools/
/models/
/.cache/
/hf-cache/
/empty-hf-cache/
# assets/face_detection_yunet_2023mar.onnx and assets/app.ico are required assets.
# Do not ignore all ONNX files, icons, or binary files globally.

# Generated videos, transcripts, captions, thumbnails, and job reports
/downloads/*
!/downloads/.gitkeep
/transcripts/*
!/transcripts/.gitkeep
/outputs/*
!/outputs/.gitkeep
/shorts/*
!/shorts/.gitkeep
/desktop-preview.png
*.part
*.ytdl
*.partial.mp4

# Logs and temporary files
*.log
*.tmp
*.temp
*.bak

# Test, lint, type-checking, and coverage caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/
.tox/
.nox/
.coverage
.coverage.*
coverage.xml
htmlcov/

# Local credentials and environment overrides
.env
.env.*
!.env.example
!.env.sample
!.env.template

# Personal editor settings
/.vscode/
/.idea/
*.code-workspace
*.swp
*.swo
*~

# Operating system metadata
.DS_Store
._*
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
